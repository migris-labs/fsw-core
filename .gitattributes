# Normalise line endings across OSes.
* text=auto eol=lf

# Source files
*.cpp     text diff=cpp
*.hpp     text diff=cpp
*.cc      text diff=cpp
*.cxx     text diff=cpp
*.h       text diff=c
*.c       text diff=c
*.ipp     text diff=cpp
*.tpp     text diff=cpp

# Build / tooling
*.cmake   text
*.txt     text
CMakeLists.txt text

# Markup / config
*.md      text
*.yml     text
*.yaml    text
*.json    text
*.toml    text

# Scripts
*.sh      text eol=lf

# Binary assets
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.pdf     binary

# Linguist overrides
cmake/*   linguist-language=CMake
docs/*    linguist-documentation
